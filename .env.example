# ==============================================================================
# AGENTIC ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual credentials.
# Note: .env is ignored by git and will never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System 2: Frontier Model (Google Gemini Cloud)
# Get your free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended default: gemini-2.0-flash (fast, high throughput, low cost)
# Other options: gemini-2.0-pro-exp-02-05, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Optional: Google Cloud Vertex AI (Only needed if using enterprise GCP project)
# ------------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# 2. System 1: Jev Decision Engine
# Mode: "local" (default: in-memory Go, zero API cost, no key needed)
#       "cloud" (hosted TypeSafe AI endpoint)
# ------------------------------------------------------------------------------
JEV_MODE=local
# TYPESAFE_API_KEY=your_typesafe_key_here_if_using_cloud_mode
